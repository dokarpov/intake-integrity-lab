{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.staging"
  },
  "deploy": {
    "preDeployCommand": "node scripts/migrate-staging.mjs --apply && node scripts/seed-staging.mjs",
    "startCommand": "node service/server.mjs",
    "healthcheckPath": "/readyz",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE"
  }
}
