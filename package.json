{
  "name": "intake-integrity-lab",
  "version": "0.6.2",
  "private": false,
  "type": "module",
  "description": "Authenticated multi-tenant sales intake integrity service with compliance ledger, DSR and policy workflows, team review operations, 1C delivery, and production integration-test harnesses.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "demo": "python3 -m http.server 4173",
    "ledger:demo": "node examples/compliance-ledger.mjs",
    "ledger:verify": "node scripts/verify-ledger.mjs",
    "audit:export": "node scripts/export-audit-bundle.mjs",
    "verify:bundle": "node scripts/verify-enterprise-bundle.mjs",
    "recovery:verify": "node scripts/recovery-verify.mjs",
    "controls:check": "node scripts/control-health.mjs",
    "service": "node service/server.mjs",
    "db:plan": "node scripts/migrate-staging.mjs",
    "db:migrate:staging": "node scripts/migrate-staging.mjs --apply",
    "db:seed:staging": "node scripts/seed-staging.mjs",
    "test:unit": "node --test tests/*.test.js",
    "test:integration:postgres": "node --test tests/integration/postgres.live.test.js tests/integration/sales-integrity.live.test.js tests/integration/source-comparison.live.test.js",
    "test:integration:aws": "node --test tests/integration/aws.live.test.js",
    "test:integration:one-c": "node --test tests/integration/one-c.live.test.js",
    "test:integration": "node --test tests/integration/*.live.test.js",
    "worker:delivery": "node service/delivery-worker.mjs",
    "test:integration:sales-integrity": "node --test tests/integration/sales-integrity.live.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "optionalDependencies": {
    "@aws-sdk/client-kms": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "pg": "^8.0.0",
    "pkcs11js": "^2.1.6"
  },
  "author": "Daria Karpova <dokarpov>",
  "keywords": [
    "sales-intake",
    "compliance",
    "audit-ledger",
    "gdpr",
    "dsr",
    "1c",
    "crm",
    "human-in-the-loop",
    "agentic",
    "control-plane",
    "worm"
  ]
}
